# کلید API سرویس Routeway
ROUTEWAY_API_KEY=your_api_key_here

# اتصال MongoDB Atlas (برای ذخیره دائمی sessionها)
# نمونه: mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=

# نام دیتابیس (اختیاری)
MONGODB_DB=shadow_legends

# مدل هوش مصنوعی (شناسه‌ی دقیق از routeway.ai/models). پیش‌فرض:
AI_MODEL=deepseek-v4-flash:free
# گزینه‌های رایگان دیگر: minimax-m2.7:free ، muse-glimmer-30b:free
